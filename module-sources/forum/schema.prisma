// Forum Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// @@user-relations-start
//   topics     ForumTopic[]
//   posts      ForumPost[]
//   topicLikes ForumTopicLike[]
//   postLikes  ForumPostLike[]
// @@user-relations-end

// ==================== FORUM MODULE ====================

model ForumCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// A section inside a section. A child is never more open than its parent;
  /// see lib/permissions.ts for why that rule is worth more than the rest.
  parentId String?
  parent   ForumCategory?  @relation("ForumCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ForumCategory[] @relation("ForumCategoryTree")

  permissions ForumCategoryPermission[]

  topics ForumTopic[]

  @@index([parentId])
}

/// One line of the matrix: what a role may do in a category.
///
/// A category with no lines at all is open to everybody. A category with lines
/// that do not name a role is shut to it. The two silences mean opposite
/// things on purpose; lib/permissions.ts is where that is argued.
model ForumCategoryPermission {
  id         String        @id @default(cuid())
  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  roleId     String
  canView    Boolean       @default(true)
  canPost    Boolean       @default(true)
  canReply   Boolean       @default(true)

  @@unique([categoryId, roleId])
  @@index([roleId])
}

model ForumTopic {
  id              String   @id @default(cuid())
  number          Int      @unique @default(autoincrement())
  title           String
  slug            String   @unique
  content         String   @db.Text
  isPinned        Boolean  @default(false)
  isLocked        Boolean  @default(false)
  moderationState String   @default("APPROVED")
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id])
  authorId   String?
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  posts ForumPost[]
  likes ForumTopicLike[]

  @@index([categoryId])
  @@index([authorId])

  // The moderation queue counts and lists PENDING rows on every load of the
  // admin screen, once per provider, with nothing else to narrow it. createdAt
  // carries the stats screen's date window.
  @@index([moderationState])
  @@index([createdAt])

  // The front page reads pinned first, then newest, twenty at a time. A
  // single-column index cannot serve a two-key sort, so `createdAt` alone left
  // Postgres reading every topic and sorting them: 316 shared buffers against
  // 4 on 4000 topics, and the whole table rather than the first twenty rows.
  @@index([isPinned, createdAt])
}

model ForumPost {
  id              String   @id @default(cuid())
  content         String   @db.Text
  moderationState String   @default("APPROVED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  topicId  String
  topic    ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  likes ForumPostLike[]

  @@index([topicId])
  @@index([authorId])

  // The moderation queue counts and lists PENDING rows on every load of the
  // admin screen, once per provider, with nothing else to narrow it.
  @@index([moderationState])
}

model ForumTopicLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  topicId String
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([userId])
}

model ForumPostLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}
