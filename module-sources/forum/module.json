  "searchProviders": [
    {
      "id": "forum-search",
      "label": "Forum",
      "handler": "search/handler.ts",
      "icon": "MessageSquare",
      "indexes": [
        {
          "table": "ForumTopic",
          "columns": [
            "title",
            "content"
          ]
        }
      ]
    }
  ],
  "notificationTypes": [
    {
      "eventType": "forum.topic.replied",
      "label": "Reply on your forum topic",
      "channels": [
        "email",
        "site"
      ]
    }
  ],
  "seoRoutes": {
    "handler": "seo/sitemap.ts"
  },
  "userDataExport": [
    {
      "model": "forumTopic",
      "key": "forum.topics",
      "column": "authorId"
    },
    {
      "model": "forumPost",
      "key": "forum.posts",
      "column": "authorId"
    },
    {
      "model": "forumTopicLike",
      "key": "forum.topicLikes",
      "column": "userId"
    },
    {
      "model": "forumPostLike",
      "key": "forum.postLikes",
      "column": "userId"
    }
  ],
  "moderationProviders": [
    {
      "id": "forum-topic",
      "label": "Forum topics",
      "labelKey": "moderation_forumTopic",
      "settingKey": "forum_topics",
      "settingLabelKey": "moderationSettings_forumTopics",
      "settingDescKey": "moderationSettings_forumTopicsDesc",
      "handler": "moderation/topics.ts"
    },
    {
      "id": "forum-post",
      "label": "Forum posts",
      "labelKey": "moderation_forumPost",
      "settingKey": "forum_posts",
      "settingLabelKey": "moderationSettings_forumReplies",
      "settingDescKey": "moderationSettings_forumRepliesDesc",
      "handler": "moderation/posts.ts"
    }
  ],
  "navLinks": [
    {
      "label": "Forum",
      "labelKey": "forum",
      "href": "/forum",
      "icon": "MessageSquare",
      "position": 20
    }
  ],
  "footerLinks": [
    {
      "label": "Forum",
      "labelKey": "forum",
      "href": "/forum",
      "section": "quick"
    }
  ],
  "activityTitles": [
    {
      "type": "forum.topic.created",
      "prefix": "New topic: ",
      "key": "forumTopicCreated"
    },
    {
      "type": "forum.post.created",
      "prefix": "Replied to: ",
      "key": "forumPostCreated"
    }
  ],
  "permissionResources": [
    "forum.topic",
    "forum.category"
  ]
}
