  ],
  "seoRoutes": {
    "handler": "seo/sitemap.ts"
  },
  "userDataExport": [
    {
      "model": "forumTopic",
      "key": "forum.topics",
      "column": "authorId",
      "erasure": "retain"
    },
    {
      "model": "forumPost",
      "key": "forum.posts",
      "column": "authorId",
      "erasure": "retain"
    },
    {
      "model": "forumTopicLike",
      "key": "forum.topicLikes",
      "column": "userId",
      "erasure": "purge"
    },
    {
      "model": "forumPostLike",
      "key": "forum.postLikes",
      "column": "userId",
      "erasure": "purge"
    }
  ],
