  "searchProviders": [
    {
      "id": "help-center-search",
      "label": "Help Center",
      "handler": "search/handler.ts",
      "icon": "BookOpen",
      "indexes": [
        {
          "table": "HelpArticle",
          "columns": [
            "title",
            "content"
          ]
        }
      ]
    }
  ],
  "seoRoutes": {
    "handler": "seo/sitemap.ts"
  },
