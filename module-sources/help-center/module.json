{
  "id": "help-center",
  "name": "Help Center",
  "description": "Knowledge base with categories and searchable articles",
  "version": "1.1.3",
  "coreVersion": "^1.0.0",
  "category": "management",
  "author": "uxwVend Team",
  "icon": "HelpCircle",
  "permissions": [
    "help-center.view",
    "help-center.manage"
  ],
  "settings": [
    {
      "key": "enableSearch",
      "type": "boolean",
      "default": true,
      "label": "Include articles in site search",
      "description": "Whether help articles are returned by the site-wide search."
    },
    {
      "key": "showViewCount",
      "type": "boolean",
      "default": true,
      "label": "Show view counts",
      "description": "Display how many times each article has been read."
    },
    {
      "key": "enableFeedback",
      "type": "boolean",
      "default": true,
      "label": "Collect article feedback",
      "description": "Show the helpful / not helpful buttons and accept their votes."
    }
  ],
  "menu": [
    {
      "label": "Help Center",
      "path": "/help",
      "icon": "HelpCircle"
    }
  ],
  "routes": [
    {
      "path": "/help",
      "component": "pages/public/help/page.tsx",
      "titleKey": "pageTitles.help"
    },
    {
      "path": "/help/[slug]",
      "component": "pages/public/help/[slug]/page.tsx",
      "resolver": "lib/article-exists.ts",
      "titleKey": "pageTitles.article"
    },
    {
      "path": "/help/category/[slug]",
      "component": "pages/public/help/category/[slug]/page.tsx",
      "resolver": "lib/category-exists.ts",
      "titleKey": "pageTitles.category"
    }
  ],
  "adminRoutes": [
    {
      "path": "/help",
      "component": "pages/admin/help/page.tsx"
    }
  ],
  "api": [
    {
      "path": "/help/articles",
      "handler": "api/help/articles/route.ts",
      "description": "List help center articles and create new ones (admin)."
    },
    {
      "path": "/help/articles/[slug]",
      "handler": "api/help/articles/[slug]/route.ts",
      "description": "Get a help article by slug or update/delete it (admin)."
    },
    {
      "path": "/help/categories",
      "handler": "api/help/categories/route.ts",
      "description": "List help center categories and create new ones (admin)."
    },
    {
      "path": "/help/categories/[id]",
      "handler": "api/help/categories/[id]/route.ts",
      "description": "Update or delete a help centre category (admin)."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "helpcenter.article.created",
      "type": "action"
    }
  ],
