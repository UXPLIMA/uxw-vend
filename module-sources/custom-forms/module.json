{
  "id": "custom-forms",
  "name": "Custom Forms",
  "description": "Dynamic form builder with submissions",
  "version": "1.0.15",
  "coreVersion": "^1.0.0",
  "category": "content",
  "author": "uxwVend",
  "icon": "FileEdit",
  "permissions": [
    "custom-forms.manage"
  ],
  "menu": [
    {
      "label": "Custom Forms",
      "path": "/forms",
      "icon": "FileEdit"
    },
    {
      "label": "Form Submissions",
      "path": "/form-submissions",
      "icon": "Inbox"
    }
  ],
  "routes": [
    {
      "path": "/form/[slug]",
      "component": "pages/public/[slug]/page.tsx",
      "resolver": "lib/route-exists.ts"
    }
  ],
  "adminRoutes": [
    {
      "path": "/forms",
      "component": "pages/admin/page.tsx"
    },
    {
      "path": "/form-submissions",
      "component": "pages/admin/submissions/page.tsx"
    }
  ],
  "api": [
    {
      "path": "/forms",
      "handler": "api/route.ts",
      "description": "List custom forms and create new ones (admin)."
    },
    {
      "path": "/forms/[slug]",
      "handler": "api/[slug]/route.ts",
      "description": "Get a form definition, submit it, or update/delete it (admin)."
    },
    {
      "path": "/forms/submissions",
      "handler": "api/submissions/route.ts",
      "description": "List form submissions (admin)."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "customforms.form.created",
      "type": "action"
    },
    {
      "hook": "customforms.form.deleted",
      "type": "action"
    },
    {
      "hook": "customforms.form.updated",
      "type": "action"
    },
    {
      "hook": "customforms.submission.created",
      "type": "action"
    }
  ],
