{
  "id": "faceit-auth",
  "name": "FACEIT Login",
  "description": "Allow users to sign in with their FACEIT account",
  "version": "1.0.1",
  "coreVersion": "^1.0.0",
  "category": "integration",
  "author": "uxwVend",
  "icon": "Swords",
  "adminRoutes": [
    {
      "path": "/settings/faceit-auth",
      "component": "pages/admin/settings/faceit-auth/page.tsx"
    }
  ],
  "settingsCards": [
    {
      "title": "FACEIT OAuth",
      "description": "FACEIT application credentials.",
      "href": "/settings/faceit-auth",
      "icon": "Swords",
      "color": "text-orange-500"
    }
  ],
  "authProviders": [
