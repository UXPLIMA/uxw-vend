/// One row per order this module has tried to invoice.
///
/// Written before the call, not after it. A legal invoice issued twice for
/// one sale is a second entry in somebody's books and has to be cancelled by
/// hand, and the trigger arrives more than once in normal operation: a
/// gateway retries its callback, an operator marks an order paid that a
/// webhook was already settling, a container restarts mid-request. The unique
/// key on the order is what makes two racing completions produce one invoice.
///
/// A row that could not be issued keeps the reason rather than disappearing.
/// An operator installed this because they have to issue invoices, so an
/// order they cannot is the one thing they need to be shown.
model IssuedInvoice {
  id        String   @id @default(cuid())
  orderId   String   @unique
  /// pending while the call is in flight, then recorded or failed.
  ///
  /// `recorded` means the sale is in the accounting service. It used to read
  /// `issued`, which told an operator their invoicing obligation was met when
  /// only half of it had been; see lib/invoice-state.ts.
  status    String   @default("pending")
  /// Where the legal e-document stands: not_requested, submitted, waiting,
  /// approved, refused or failed. Kept apart from `status` because they are
  /// different questions - a sale can be recorded here and its document
  /// refused by the authority - and one word for both is what hid the gap
  /// while this module could not ask for a document at all.
  legalDocument String @default("not_requested")
  /// Which document the buyer was owed: e_invoice for a tax number
  /// registered at the authority, e_archive for everybody else.
  legalKind     String?
  /// The job the service is doing it under, and the document once it exists.
  legalJobId    String?
  legalRemoteId String?
  /// The official number, which is what an accountant asks for.
  legalNumber   String?
  /// Why the document was refused, or why the call could not be made.
  legalReason   String?
  legalAt       DateTime?
  /// What the document needs and the sale is the only source of: whose tax
  /// number it is made out to, how it was paid for and when. Kept here so
  /// asking for a document later reads this module's own row rather than
  /// reaching into the shop's orders for three fields.
  buyerTaxNumber String?
  paymentMethod  String?
  paidAt         DateTime?
  /// The service's own id and number, once it has answered.
  remoteId     String?
  remoteNumber String?
  /// Why it could not be issued, in the words the operator needs.
  reason    String?
  attempts  Int      @default(0)
  issuedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([legalDocument])
}
