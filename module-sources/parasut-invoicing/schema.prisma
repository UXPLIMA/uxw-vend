/// One row per order this module has tried to invoice.
///
/// Written before the call, not after it. A legal invoice issued twice for
/// one sale is a second entry in somebody's books and has to be cancelled by
/// hand, and the trigger arrives more than once in normal operation: a
/// gateway retries its callback, an operator marks an order paid that a
/// webhook was already settling, a container restarts mid-request. The unique
/// key on the order is what makes two racing completions produce one invoice.
///
/// A row that could not be issued keeps the reason rather than disappearing.
/// An operator installed this because they have to issue invoices, so an
/// order they cannot is the one thing they need to be shown.
model IssuedInvoice {
  id        String   @id @default(cuid())
  orderId   String   @unique
  /// pending while the call is in flight, then recorded or failed.
  ///
  /// `recorded` means the sale is in the accounting service. It used to read
  /// `issued`, which told an operator their invoicing obligation was met when
  /// only half of it had been; see lib/invoice-state.ts.
  status    String   @default("pending")
  /// Where the legal e-document stands. One value today, because nothing here
  /// asks for one: the second call that turns a sales invoice into an
  /// e-archive or an e-invoice is not made. Kept apart from `status` so the
  /// day it is made, the answer has somewhere true to live.
  legalDocument String @default("not_requested")
  /// The service's own id and number, once it has answered.
  remoteId     String?
  remoteNumber String?
  /// Why it could not be issued, in the words the operator needs.
  reason    String?
  attempts  Int      @default(0)
  issuedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([legalDocument])
}
