{
  "id": "iyzico-gateway",
  "name": "iyzico Payment Gateway",
  "description": "Take Turkish card payments through iyzico, with instalments and 3D Secure",
  "version": "1.0.1",
  "coreVersion": "^1.3.0",
  "category": "commerce",
  "author": "uxwVend",
  "icon": "CreditCard",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "iyzico",
      "description": "iyzico API keys and environment.",
      "href": "/settings/iyzico",
      "icon": "CreditCard",
      "color": "text-emerald-500"
    }
  ],
  "menu": [
    {
      "label": "iyzico Settings",
      "path": "/settings/iyzico",
      "icon": "CreditCard"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/iyzico",
      "component": "pages/admin/page.tsx"
    }
  ],
  "api": [
    {
      "path": "/iyzico/callback",
      "providerCallback": true,
      "handler": "api/callback/route.ts",
      "method": "POST",
      "description": "Where iyzico posts the result of a checkout form. Reads the payment back from iyzico before settling it."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
