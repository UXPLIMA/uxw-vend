{
  "id": "iyzico-gateway",
  "name": "iyzico Payment Gateway",
  "description": "Take Turkish card payments through iyzico, with instalments and 3D Secure",
  "version": "1.0.2",
  "coreVersion": "^1.3.0",
  "category": "commerce",
  "author": "uxwVend",
  "icon": "CreditCard",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "iyzico",
      "description": "iyzico API keys and environment.",
      "href": "/settings/iyzico",
      "icon": "CreditCard",
      "color": "text-emerald-500"
    }
  ],
  "menu": [
    {
      "label": "iyzico Settings",
      "path": "/settings/iyzico",
      "icon": "CreditCard"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/iyzico",
      "component": "pages/admin/page.tsx"
    }
  ],
  "api": [
    {
      "path": "/iyzico/callback",
      "providerCallback": true,
      "handler": "api/callback/route.ts",
      "method": "POST",
      "description": "Where iyzico posts the result of a checkout form. Reads the payment back from iyzico before settling it."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "iyzicoGateway": {
        "adm_title": "iyzico Settings",
        "adm_subtitle": "Keys for taking payments through iyzico.",
        "adm_apiKey": "API Key",
        "adm_apiKeyDesc": "From your iyzico dashboard.",
        "adm_secretKey": "Secret Key",
        "adm_secretKeyDesc": "From your iyzico dashboard.",
        "adm_sandbox": "Sandbox Mode",
        "adm_sandboxDesc": "Set to true to use the iyzico test environment."
      },
      "admin": {
        "menu_iyzico-gateway": "iyzico Gateway",
        "menu_iyzico-gateway_iyzico_settings": "iyzico Settings"
      }
    },
    "tr": {
      "iyzicoGateway": {
        "adm_title": "iyzico Ayarları",
        "adm_subtitle": "iyzico ile ödeme almak için gereken anahtarlar.",
        "adm_apiKey": "API Anahtarı",
        "adm_apiKeyDesc": "iyzico panelinden alınır.",
        "adm_secretKey": "Gizli Anahtar",
        "adm_secretKeyDesc": "iyzico panelinden alınır.",
        "adm_sandbox": "Test Ortamı",
        "adm_sandboxDesc": "iyzico test ortamı için true yazın."
      },
      "admin": {
        "menu_iyzico-gateway": "iyzico Ödeme",
        "menu_iyzico-gateway_iyzico_settings": "iyzico Ayarları"
      }
    }
  }
}
