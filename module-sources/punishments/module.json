{
  "id": "punishments",
  "name": "Punishments",
  "description": "Player punishment history and ban management",
  "version": "1.0.8",
  "coreVersion": "^1.0.0",
  "category": "gaming",
  "author": "uxwVend",
  "icon": "Shield",
  "permissions": [
    "punishments.manage"
  ],
  "routes": [
    {
      "path": "/punishments",
      "component": "pages/public/page.tsx"
    }
  ],
  "adminRoutes": [
    {
      "path": "/punishments",
      "component": "pages/admin/page.tsx"
    }
  ],
  "menu": [
    {
      "label": "Punishments",
      "path": "/punishments",
      "icon": "Shield"
    }
  ],
  "navLinks": [
    {
      "label": "Punishments",
      "labelKey": "punishments",
      "href": "/punishments",
      "icon": "Shield",
      "position": 80
    }
  ],
  "api": [
    {
      "path": "/punishments",
      "handler": "api/route.ts",
      "description": "List punishments and create new ones (admin)."
    },
    {
      "path": "/punishments/[id]",
      "handler": "api/[id]/route.ts",
      "description": "Update or delete a single punishment (admin)."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "punishments.punishment.issued",
      "type": "action"
    },
    {
      "hook": "punishments.punishment.revoked",
      "type": "action"
    }
  ],
