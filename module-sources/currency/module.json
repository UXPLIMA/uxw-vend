{
  "id": "currency",
  "name": "Multi-Currency",
  "description": "Multi-currency support with automatic conversion",
  "version": "1.0.6",
  "coreVersion": "^1.0.0",
  "category": "commerce",
  "author": "uxwVend",
  "icon": "DollarSign",
  "menu": [
    {
      "label": "Currency",
      "path": "/currency",
      "icon": "DollarSign"
    }
  ],
  "adminRoutes": [
    {
      "path": "/currency",
      "component": "pages/admin/page.tsx"
    }
  ],
  "api": [
    {
      "path": "/currency",
      "handler": "api/route.ts",
      "description": "List available currencies and create new ones (admin)."
    }
  ],
  "settingsCards": [
    {
      "title": "Currency Settings",
      "description": "Manage currencies and exchange rates",
      "href": "/currency",
      "icon": "DollarSign",
      "color": "text-green-500"
    }
  ],
  "footerComponents": [
    {
      "id": "CurrencySelector",
      "component": "components/CurrencySelector",
      "order": 10
    }
  ],
  "contextProviders": [
    {
      "id": "CurrencyProvider",
      "component": "lib/context",
      "order": 10
    }
  ],
  "cronJobs": [
    {
      "id": "currency-rate-refresh",
      "schedule": "every-hour",
      "handler": "cron/refresh.ts"
    }
  ],
