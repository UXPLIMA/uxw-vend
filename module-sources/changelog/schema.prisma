// Changelog Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// ==================== CHANGELOG ====================

model ChangelogEntry {
  id        String   @id @default(cuid())
  /// Stable number in the URL, so renaming a release does not break a link
  /// somebody has already shared. The slug beside it is cosmetic, which is
  /// the same shape an article uses.
  number    Int      @unique @default(autoincrement())
  slug      String   @default("")
  version   String
  title     String
  /// The summary on the timeline. Kept short on purpose: it is read in a list.
  content   String   @db.Text
  /// The long form, for a release that needs more than a line - what was
  /// tried, a screenshot, the steps to take. Absent for most entries, and a
  /// release without one has no page of its own and no link to follow.
  details     String? @db.Text
  /// Drawn at the top of that page and nowhere else. The timeline is a list of
  /// releases and a picture per row would bury the one thing it is for.
  coverImage  String?
  type      String   @default("update")
  color     String?  @default("#3b82f6")
  isActive  Boolean  @default(true)
  publishAt DateTime?
  createdAt DateTime @default(now())

  @@index([slug])
}
