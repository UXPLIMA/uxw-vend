{
  "id": "spotify-auth",
  "name": "Spotify Login",
  "description": "Allow users to sign in with their Spotify account",
  "version": "1.0.0",
  "coreVersion": "^1.0.0",
  "category": "integration",
  "author": "uxwVend",
  "icon": "Music",
  "adminRoutes": [
    {
      "path": "/settings/spotify-auth",
      "component": "pages/admin/settings/spotify-auth/page.tsx"
    }
  ],
  "settingsCards": [
    {
      "title": "Spotify OAuth",
      "description": "Spotify application credentials.",
      "href": "/settings/spotify-auth",
      "icon": "Music",
      "color": "text-green-500"
    }
  ],
  "authProviders": [
    {
      "id": "spotify",
      "envIdVar": "AUTH_SPOTIFY_ID",
      "envSecretVar": "AUTH_SPOTIFY_SECRET"
    }
  ],
  "oauthButtons": [
    {
      "id": "spotify-login",
      "provider": "spotify",
      "label": "Spotify",
      "color": "#1DB954",
