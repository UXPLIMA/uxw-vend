// Marketplace Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// @@user-relations-start
//   marketListings MarketListing[] @relation("MarketListings")
// @@user-relations-end
// NOTE: a listing cascades with its seller - a listing nobody can buy from is
// noise. A sale does not: it is money that moved, so the buyer and seller are
// held as plain ids and the row outlives either account, the same way the
// credit ledger does.

/// One member offering something to another for credits.
///
/// The listing names a kind of thing rather than the thing itself: what is
/// handed over is decided by whatever integration is installed, and this
/// module never learns what a "game item" is.
model MarketListing {
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation("MarketListings", fields: [sellerId], references: [id], onDelete: Cascade)
  title     String
  body      String?  @db.Text
  /// Whole credits. A listing at nothing is a giveaway, not a sale.
  price     Int
  /// Which installed integration hands it over. Checked again when it sells,
  /// because a module gets uninstalled and its listings outlive it.
  kind      String
  /// What that integration needs to deliver it: an item id, a role, a code.
  payload   Json?
  isActive  Boolean  @default(true)
  isSold    Boolean  @default(false)
  soldAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     MarketSale[]

  @@index([isActive, isSold, createdAt])
  @@index([sellerId])
}

/// What happened when a listing sold.
///
/// Kept separately from the listing so the three numbers that moved are on one
/// row: a sale is the only place the site's cut is visible, and a listing that
/// is later edited must not change what was paid for it.
model MarketSale {
  id          String   @id @default(cuid())
  listingId   String
  listing     MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId     String
  sellerId    String
  /// What the buyer paid, what the site kept, what the seller received. The
  /// last is the remainder of the first two and never computed on its own.
  price       Int
  commission  Int
  toSeller    Int
  /// pending while the handover runs, then delivered or failed.
  delivery    String   @default("pending")
  /// Why it could not be handed over, for the operator who has to unpick it.
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([listingId])
  @@index([buyerId])
  @@index([delivery])
}
