{
  "id": "cloudflare-r2",
  "name": "Cloudflare R2 Storage",
  "description": "S3-compatible object storage backed by Cloudflare R2 (zero egress fees)",
  "version": "1.0.6",
  "coreVersion": "^1.0.0",
  "category": "integration",
  "author": "uxwVend",
  "icon": "Cloud",
  "permissions": [
    "cloudflare-r2.manage"
  ],
  "menu": [
    {
      "label": "Cloudflare R2",
      "path": "/storage/cloudflare-r2",
      "icon": "Cloud"
    }
  ],
  "adminRoutes": [
    {
      "path": "/storage/cloudflare-r2",
      "component": "pages/admin/page.tsx"
    }
  ],
  "api": [
    {
      "path": "/storage/cloudflare-r2/settings",
      "handler": "api/settings/route.ts",
      "description": "Get or update Cloudflare R2 storage settings (admin)."
    }
  ],
  "settingsCards": [
    {
      "title": "Cloudflare R2 Storage",
      "description": "Configure R2 bucket for file uploads (S3-compatible)",
      "href": "/storage/cloudflare-r2",
      "icon": "Cloud",
      "color": "text-orange-500"
    }
  ],
  "storageProviders": [
    {
      "id": "cloudflare-r2",
      "name": "Cloudflare R2",
      "handler": "lib/provider.ts"
    }
  ],
