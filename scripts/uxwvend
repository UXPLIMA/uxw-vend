#!/usr/bin/env bash
#
# uxwVend management CLI. Installed to /usr/local/bin/uxwvend by install.sh.
#
# Everything here is a thin, memorable wrapper over the docker compose
# invocation the installation actually needs — including the compose file
# list and the tls profile, which are easy to get wrong by hand and produce
# confusing results when you do (a forgotten `--profile tls` silently stops
# Caddy on the next `up`).
set -euo pipefail

CONF=/etc/uxwvend.conf
UXWVEND_DIR=/opt/uxwvend
# shellcheck disable=SC1090
if [ -f "$CONF" ]; then . "$CONF"; fi

if [ -t 1 ]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
else
    C_RESET=""; C_BOLD=""; C_RED=""; C_GREEN=""; C_YELLOW=""
fi
die()  { printf '%s✗ %s%s\n' "$C_RED" "$*" "$C_RESET" >&2; exit 1; }
ok()   { printf '%s✓ %s%s\n' "$C_GREEN" "$*" "$C_RESET"; }
info() { printf '  %s\n' "$*"; }

[ -d "$UXWVEND_DIR" ] || die "No installation at $UXWVEND_DIR. Set UXWVEND_DIR in $CONF."
[ -f "$UXWVEND_DIR/.env" ] || die "No .env at $UXWVEND_DIR/.env — is this an uxwVend installation?"

env_get() { grep -E "^$1=" "$UXWVEND_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- || true; }

# The tls profile must be repeated on every compose call. Omitting it on an
# `up` would leave Caddy stopped and the site unreachable on 443.
COMPOSE_ARGS=(-f docker-compose.yml)
case "$(env_get AUTH_URL)" in
    https://*)
        if [ -n "$(env_get DOMAIN)" ]; then COMPOSE_ARGS+=(--profile tls); fi
        ;;
esac

compose() { ( cd "$UXWVEND_DIR" && docker compose "${COMPOSE_ARGS[@]}" "$@" ); }

usage() {
    cat <<'USAGE'
uxwvend — manage this uxwVend installation

  uxwvend update [TAG]   pull the newest image (or TAG), migrate, restart
  uxwvend backup         dump the database to <install-dir>/backups
  uxwvend restore FILE   restore a dump (destructive — asks first)
  uxwvend logs [SVC]     follow logs; SVC is app, db, redis, caddy or migrate
  uxwvend restart        restart the stack
  uxwvend stop           stop the stack (data is kept)
  uxwvend start          start it again
  uxwvend status         what is running, and whether the app is healthy
  uxwvend version        installed image tag
USAGE
}

cmd="${1:-help}"; shift || true

case "$cmd" in

update)
    tag="${1:-}"
    if [ -n "$tag" ]; then
        # Rewrite in place so a later plain `update` keeps the pinned tag.
        if grep -qE '^UXWVEND_VERSION=' "$UXWVEND_DIR/.env"; then
            sed -i -E "s|^UXWVEND_VERSION=.*|UXWVEND_VERSION=$tag|" "$UXWVEND_DIR/.env"
        else
            printf 'UXWVEND_VERSION=%s\n' "$tag" >> "$UXWVEND_DIR/.env"
        fi
        info "Pinned to $tag"
    fi
    info "Pulling…"
    compose pull
    # `up -d` re-runs the migrate service, which merges schemas, pushes them
    # and applies module migrations before the app is allowed to start.
    info "Migrating and restarting…"
    compose up -d
    port="$(env_get APP_PORT)"; port="${port:-3001}"
    # Up to 15 minutes. Module pages are compiled into the app, so the first
    # boot on a new image recompiles them against the modules in the volume
    # before it serves anything (see scripts/reconcile-build.ts). That is a
    # full `next build` — minutes on a small VPS, and the reason this wait is
    # not the 3 minutes it used to be.
    notified=0
    for i in $(seq 1 300); do
        if curl -fsS --max-time 5 "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then
            ok "Updated and healthy"; exit 0
        fi
        if [ "$i" -eq 10 ] && [ "$notified" -eq 0 ]; then
            notified=1
            info "Still starting. If you have modules installed, the app is
  recompiling them for this version — several minutes is normal.
  Watch it with: uxwvend logs"
        fi
        sleep 3
    done
    die "The app is not answering after the update. Run 'uxwvend logs' to see why."
    ;;

backup)
    mkdir -p "$UXWVEND_DIR/backups"
    out="$UXWVEND_DIR/backups/uxwvend-$(date -u '+%Y%m%d-%H%M%S').sql.gz"
    info "Dumping…"
    # -T: no TTY, so the stream stays clean when redirected.
    compose exec -T db pg_dump -U uxwvend -d uxwvend --clean --if-exists \
        | gzip > "$out"
    ok "$out ($(du -h "$out" | cut -f1))"
    printf '\n  %sThis dump does NOT contain .env.%s Secrets encrypted with\n' "$C_YELLOW" "$C_RESET"
    printf '  SECRET_ENCRYPTION_KEY are unreadable without it — back up\n'
    printf '  %s separately.\n' "$UXWVEND_DIR/.env"
    ;;

restore)
    file="${1:-}"
    [ -n "$file" ] || die "Usage: uxwvend restore <file.sql.gz>"
    [ -f "$file" ] || die "No such file: $file"
    printf '%sThis overwrites the current database with %s.%s\n' "$C_BOLD" "$file" "$C_RESET"
    printf 'Type the word restore to continue: '
    read -r confirm
    [ "$confirm" = "restore" ] || die "Cancelled."
    # Stop the app first. Restoring under a live app means the dump's DROPs
    # race against in-flight queries, and any write that lands mid-restore is
    # lost when the next statement drops its table.
    info "Stopping the app…"
    compose stop app
    info "Restoring…"
    if [ "${file##*.}" = "gz" ]; then
        gunzip -c "$file" | compose exec -T db psql -U uxwvend -d uxwvend -q
    else
        compose exec -T db psql -U uxwvend -d uxwvend -q < "$file"
    fi
    info "Starting the app…"
    compose up -d
    ok "Restored from $file"
    ;;

logs)    compose logs -f --tail=100 "$@" ;;
restart) compose restart; ok "Restarted" ;;
stop)    compose stop; ok "Stopped (data kept — 'uxwvend start' brings it back)" ;;
start)   compose up -d; ok "Started" ;;

status)
    compose ps
    port="$(env_get APP_PORT)"; port="${port:-3001}"
    printf '\n'
    if curl -fsS --max-time 5 "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then
        ok "App healthy at $(env_get AUTH_URL)"
    else
        printf '%s✗ App not answering on 127.0.0.1:%s%s\n' "$C_RED" "$port" "$C_RESET"
    fi
    ;;

version)
    printf '%s:%s\n' "$(env_get UXWVEND_IMAGE)" "$(env_get UXWVEND_VERSION)"
    ;;

help|--help|-h) usage ;;
*) printf '%sUnknown command: %s%s\n\n' "$C_RED" "$cmd" "$C_RESET" >&2; usage; exit 1 ;;
esac
