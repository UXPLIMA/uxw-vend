# uxwVend Environment Configuration
#
# You usually do NOT need this file. The installer writes a complete .env,
# with every secret generated for you:
#
#   curl -fsSL https://raw.githubusercontent.com/UXPLIMA/uxw-vend/main/install.sh | sudo bash
#
# Copy this file to .env and fill it in only for a manual (non-Docker) install
# or a development checkout.
#
# Module-specific secrets (Stripe, PayPal API keys, RCON, Discord bot token,
# etc.) are configured through Admin Panel > Settings after installing the
# relevant module. Only platform-wide variables live here.
#
# The one exception is OAuth sign-in. A module that declares `authProviders`
# names the env vars holding its client id and secret (for example
# AUTH_<PROVIDER>_ID / AUTH_<PROVIDER>_SECRET), because Auth.js builds its
# configuration at process start, before any database read. The module's README
# names the exact variables; the provider stays inactive until both are set.

# ============================================================
# REQUIRED
# ============================================================

# PostgreSQL connection string. Append ?connection_limit=20 to raise the
# Prisma pool above the default (num_cpu * 2 + 1) for cluster deployments
# - long-running hooks or big batch jobs can otherwise pin every slot.
DATABASE_URL="postgresql://user:password@localhost:5432/uxwvend"

# Sign JWTs with this. Generate with: openssl rand -base64 32
# Must be identical across every app replica behind the same load balancer.
AUTH_SECRET="your-secret-key-here"

# Canonical URL the platform is served at, and the single source of truth
# for it. Drives OAuth callback URLs, password-reset links, sitemap.xml,
# robots.txt and every OpenGraph/canonical tag (see src/core/lib/app-url.ts).
# AUTH_URL is the Auth.js v5 name; NEXTAUTH_URL is kept for backwards
# compatibility and is checked if AUTH_URL is absent.
#
# Set this to the address visitors actually type. Getting it wrong does not
# break the site, but every canonical URL it publishes will be wrong.
AUTH_URL="http://localhost:3001"
NEXTAUTH_URL="http://localhost:3001"

# ============================================================
# PRODUCTION RECOMMENDED
# ============================================================

# Encrypts at-rest secrets (RCON passwords, third-party API tokens that
# modules store in the DB) with AES-256-GCM. REQUIRED in production - the
# app hard-throws the first time a module reads/writes an encrypted secret
# if this is unset and NODE_ENV=production. 64-char hex (32 raw bytes).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRET_ENCRYPTION_KEY=""

# Shared secret for trusted server-to-server calls to internal status
# endpoints (sent as the `x-internal-request` header). Leave unset to disable.
# INTERNAL_API_SECRET=""

# Demo write-protection. Set to 1 on a public demo deployment to reject all
# mutating requests (visitors can browse but not change anything).
# DEMO_MODE=0

# Credentials for the admin account created by `npm run db:seed`. Without
# SEED_ADMIN_PASSWORD the seed generates a random one and prints it once.
# Re-seeding never resets an existing admin's password.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""

# Rate limiting + module status cache. REQUIRED when NODE_ENV=production,
# whatever your worker count. The in-memory fallback is process-local and
# trivially bypassable, so production without Redis does not fall back - it
# denies every rate-limited request with 429, and that includes /api/health,
# so the site reads as down. Set ALLOW_MEMORY_RATE_LIMIT=1 to accept the
# weaker limiter instead; do that only on a true single-worker deployment.
# REDIS_URL="redis://localhost:6379"
# ALLOW_MEMORY_RATE_LIMIT=0

# Resend is the current email provider. Leave empty in dev - outbound mail
# degrades to console.log automatically.
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@example.com"

# ============================================================
# OPTIONAL PLATFORM SETTINGS
# ============================================================

NODE_ENV="development"

# Display name + public URL of the site.
#
# WARNING: every NEXT_PUBLIC_* variable is inlined into the JavaScript bundle
# by `next build`, so in the prebuilt Docker image these are frozen to what CI
# had at build time and CANNOT be changed per installation. They are kept as
# fallbacks for deployments that build their own image. Use SITE_NAME for the
# display name and AUTH_URL for the address - both are read at runtime.
NEXT_PUBLIC_APP_NAME="uxwVend"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Runtime display name. Preferred over NEXT_PUBLIC_APP_NAME: it is what the
# authenticator-app issuer and outbound e-mail "from" name are built from.
# The `site_name` setting in Admin > Settings overrides it once the DB is up.
# SITE_NAME="uxwVend"

# Comma-separated list of image hostnames allowed through next/image.
# NEXT_PUBLIC_IMAGE_DOMAINS=""

# Override the storage provider. Provider modules register themselves
# (cloudflare-r2, etc.); admin picks the active one from Admin Panel.
# STORAGE_PROVIDER="cloudflare-r2"

# ============================================================
# SECURITY / HARDENING
# ============================================================

# Extra origins accepted by the CSRF proxy guard. AUTH_URL / NEXTAUTH_URL /
# NEXT_PUBLIC_APP_URL are always allowed. Add staging / preview hosts here.
# CSRF_ALLOWED_ORIGINS="https://staging.example.com,https://preview.example.com"

# Shared secret that lets server-to-server callers bypass the CSRF origin
# check by sending `x-internal-request: <secret>`. Leave unset to disable.
# CSRF_INTERNAL_SECRET=""

# Trusted reverse-proxy IPs. When set, forwarded headers (x-forwarded-for)
# are only honored if the direct connection comes from one of these IPs -
# prevents header spoofing when you're NOT behind a trusted proxy.
# TRUSTED_PROXY_IPS="10.0.0.1,10.0.0.2"

# Make the pre-generated OpenAPI spec (/api/v1/openapi) readable without
# admin auth. Off by default so anonymous clients can't enumerate every
# admin endpoint the platform exposes.
# OPENAPI_PUBLIC=0

# Abort any hook listener that takes longer than this many milliseconds so
# a misbehaving module can't hang login / checkout forever.
# HOOK_LISTENER_TIMEOUT_MS=5000

# Max time (ms) the graceful-shutdown handler has to drain before we
# force-exit. Pick lower than your PM2 kill_timeout.
# SHUTDOWN_GRACE_MS=15000

# ============================================================
# PAYPAL GATEWAY (module: paypal-gateway)
# ============================================================
# All three are REQUIRED in production for the PayPal webhook to verify
# signatures. Without them the webhook refuses to run - set
# PAYPAL_ALLOW_UNVERIFIED=1 (dev only!) to bypass.
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_WEBHOOK_ID=""
# PAYPAL_ENVIRONMENT="sandbox"
# PAYPAL_ALLOW_UNVERIFIED=0

# ============================================================
# OBSERVABILITY
# ============================================================

# Structured-log filter. debug|info|warn|error - defaults to debug in dev,
# info in production.
# LOG_LEVEL="info"

# When set to 1, scripts/postinstall.ts does NOT regenerate the schema,
# theme, and module registries. Useful for Docker layer caching pipelines
# that call the scripts explicitly after npm ci.
# SKIP_POSTINSTALL=0

# ============================================================
# DOCKER COMPOSE ONLY
# ============================================================
# These are consumed by docker-compose.yml, not by the app directly.
# When running with `docker compose up`, compose injects its own
# DATABASE_URL / REDIS_URL pointing at the sibling db/redis services, so
# the DATABASE_URL above is ignored on the compose path.

# Password for the bundled Postgres container. REQUIRED for docker compose
# (the db and app services fail to start without it). Use hex, not base64 -
# the value is interpolated into postgresql://uxwvend:<pw>@db:5432/uxwvend,
# where a '/', '@' or ':' would corrupt the connection string:
#   openssl rand -hex 24
# POSTGRES_PASSWORD=""

# Which image to run, and which tag. The installer pins these; change the tag
# with `uxwvend update <tag>` rather than editing by hand.
# Where the in-app marketplace fetches module and theme ZIPs from.
# Point this at a fork or an internal mirror to serve your own catalogue.
# Must be http(s) - the response is unzipped onto disk, so other schemes
# are rejected and the default is used instead.
# UXWVEND_MARKETPLACE_BASE=https://raw.githubusercontent.com/UXPLIMA/uxw-vend/main

# UXWVEND_IMAGE="ghcr.io/uxplima/uxw-vend"
# UXWVEND_VERSION="latest"

# How the app is published on the host. With TLS, Caddy fronts the app and
# APP_BIND_ADDR is 127.0.0.1 so the container is not also reachable on its
# own port. Without TLS the app publishes APP_PORT directly.
# APP_BIND_ADDR="0.0.0.0"
# APP_PORT="3001"

# Hostname Caddy obtains a certificate for, and the address Let's Encrypt
# sends expiry warnings to. Only used when the `tls` compose profile is on.
# DOMAIN="shop.example.com"
# TLS_EMAIL="you@example.com""
